# Gateway
ALLOWED_IPS=
ADMIN_TOKEN=your_secret_admin_token
PROVIDERS_JSON={"gemini":{"baseUrl":"https://generativelanguage.googleapis.com"},"openai":{"baseUrl":"https://api.openai.com"},"anthropic":{"baseUrl":"https://api.anthropic.com"}}
GATEWAY_MODE=true

# Control plane
DATABASE_URL=jdbc:postgresql://postgres:5432/ai_proxy
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
ADMIN_EMAILS=admin@example.com

# Redis (shared)
REDIS_HOST=redis
REDIS_PORT=6379
